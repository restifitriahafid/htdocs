document.addEventListener("DOMContentLoaded", function () {
    // 1. Ambil elemen-elemen yang dibutuhkan
    const searchInput = document.querySelector(".search-input");
    const plantCards = document.querySelectorAll(".plant-card");
    const alphabetLinks = document.querySelectorAll(".alphabet-list a");
    const filterCategory = document.querySelector("select[name='kategori']");
    const filterSediaan = document.querySelector("select[name='sediaan']");

    // 2. Fungsi Filter Utama (Gabungan Pencarian, Abjad, & Dropdown)
    function filterPlants() {
        const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : "";
        const selectedCategory = filterCategory ? filterCategory.value.toLowerCase() : "";
        const selectedSediaan = filterSediaan ? filterSediaan.value.toLowerCase() : "";

        plantCards.forEach(card => {
            const plantName = card.querySelector("h5").textContent.toLowerCase();
            const latinName = card.querySelector(".latin").textContent.toLowerCase();
            const category = card.getAttribute("data-kategori") || "";
            const sediaan = card.getAttribute("data-sediaan") || "";

            // Cek kondisi pencarian teks
            const matchesSearch = plantName.includes(searchTerm) || latinName.includes(searchTerm);
            // Cek kondisi filter dropdown
            const matchesCategory = selectedCategory === "" || category.includes(selectedCategory);
            const matchesSediaan = selectedSediaan === "" || sediaan.includes(selectedSediaan);

            // Tampilkan jika semua kondisi cocok
            if (matchesSearch && matchesCategory && matchesSediaan) {
                card.style.display = "block";
                card.style.animation = "fadeIn 0.3s ease-in-out";
            } else {
                card.style.display = "none";
            }
        });
    }

    // 3. Event Listener untuk Live Search (Pencarian Langsung)
    if (searchInput) {
        searchInput.addEventListener("keyup", filterPlants);
    }

    // 4. Event Listener untuk Filter Indeks A-Z
    alphabetLinks.forEach(link => {
        link.addEventListener("click", function (e) {
            e.preventDefault(); // Mencegah reload halaman
            const selectedLetter = this.textContent.toLowerCase();

            plantCards.forEach(card => {
                const plantName = card.querySelector("h5").textContent.toLowerCase();
                if (plantName.startsWith(selectedLetter)) {
                    card.style.display = "block";
                } else {
                    card.style.display = "none";
                }
            });
        });
    });

    // 5. Event Listener untuk Dropdown Filter
    if (filterCategory) filterCategory.addEventListener("change", filterPlants);
    if (filterSediaan) filterSediaan.addEventListener("change", filterPlants);
});